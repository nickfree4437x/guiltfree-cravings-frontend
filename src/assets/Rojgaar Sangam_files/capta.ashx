        function Onchangess(option) {
            var url1 = '/webmethod.aspx/Set_HESession';
            $.ajax({
                type: "POST",
                contentType: "application/json; charset=utf-8",
                url: url1,
                data: "{'lang':'" + option + "'}",
                dataType: "json",
                success: function (data) {
                    if (data.d[0].Result == '1') {
                        window.sessionStorage.setItem('tbl_lang', '1');//Set Session Value for Jobs.htm
                        HindiEnglish(data.d[0].Result);
                        //$("#tblprivatejobs").append($("<p style='margin:10px;font-size:14px'><b style='color:maroon'>" + data.d[i].RowNumber + ".   &nbsp; " + data.d[i].orgname + "-   &nbsp;  " + data.d[i].designation + " </b>  <span style='float:right; margin:10px'><span class=''><span class='glyphicon glyphicon-calendar'></span> अंतिम तिथि " + data.d[i].lastdateof_vacancy + "</span></span><br/> &nbsp;<span style='font-weight:bold;color:#454545'> अनिवार्य शैक्षिक योग्यता </span>: " + data.d[i].reqqualification + "<br/> &nbsp;" + data.d[i].description + "<br/><span style='float:left; margin:10px'><span class='label label-success' style='font-size:14px;font-weight:normal'><span class='glyphicon glyphicon-pushpin'></span>&nbsp;वेतन प्रति माह :&nbsp;रु. " + data.d[i].salary + " </span></span> <span style='float:right; margin:10px'>&nbsp;&nbsp;<a href='pJobdescription.aspx?id=" + data.d[i].jobid + "' style='text-decoration:underline'><span class='glyphicon glyphicon-link'><i></i></span>&nbsp;रिक्ति विवरण</a> " + applyjobtext + "   </span> </p>  <hr class='hrstyle' />"));
                    }
                    else if (data.d[0].Result == '0') {
                        window.sessionStorage.setItem('tbl_lang', '0');//Set Session Value for Jobs.htm
                        HindiEnglish("0");
                    }

                },
                error: function (data) {
                    return;
                }
            });
        }
