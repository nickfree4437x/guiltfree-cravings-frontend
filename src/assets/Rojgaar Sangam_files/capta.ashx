    <script type="text/javascript">
        jQuery(document).on("change", "#mainBody_DropDownList1", function (e) {
            e.preventDefault();
            var $SelectedText = jQuery("#mainBody_DropDownList1 option:selected").text();
            jQuery('.UserClasses').html($SelectedText.trim());
            var $SelectedValue = jQuery("#mainBody_DropDownList1 option:selected").val();
            if ($SelectedValue == 'J') {
                jQuery(".JobSeeker").removeClass("hidden");
                jQuery(".Employer").addClass("hidden");
                jQuery(".DepartmentOfficers").addClass("hidden");
                jQuery(".SewaMitra").addClass("hidden");
                jQuery(".Admin").addClass("hidden");
            } else if ($SelectedValue == 'E') {
                jQuery(".Employer").removeClass("hidden");

                jQuery(".JobSeeker").addClass("hidden");
                jQuery(".DepartmentOfficers").addClass("hidden");
                jQuery(".SewaMitra").addClass("hidden");
                jQuery(".Admin").addClass("hidden");
            } else if ($SelectedValue == 'I') {
                jQuery(".DepartmentOfficers").removeClass("hidden");
                jQuery(".JobSeeker").addClass("hidden");
                jQuery(".Employer").addClass("hidden");
                jQuery(".SewaMitra").addClass("hidden");
                jQuery(".Admin").addClass("hidden");
            } else if ($SelectedValue == 'S') {
                jQuery(".SewaMitra").removeClass("hidden");
                jQuery(".JobSeeker").addClass("hidden");
                jQuery(".Employer").addClass("hidden");
                jQuery(".DepartmentOfficers").addClass("hidden");
                jQuery(".Admin").addClass("hidden");
            } else if ($SelectedValue == 'D') {
                jQuery(".Admin").removeClass("hidden");
                jQuery(".JobSeeker").addClass("hidden");
                jQuery(".Employer").addClass("hidden");
                jQuery(".DepartmentOfficers").addClass("hidden");
                jQuery(".SewaMitra").addClass("hidden");
            } else {
                jQuery(".JobSeeker").addClass("hidden");
                jQuery(".Employer").addClass("hidden");
                jQuery(".DepartmentOfficers").addClass("hidden");
                jQuery(".SewaMitra").addClass("hidden");
                jQuery(".Admin").addClass("hidden");
            }
        });
    </script>
