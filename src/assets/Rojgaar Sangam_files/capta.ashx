    <script type="text/javascript">
        function HashPwdwithSalt(salt) {
            if (document.getElementById('mainBody_Password').value != "") {
                document.getElementById('mainBody_Password').value =
                    sha256(document.getElementById('mainBody_Password').value);
                document.getElementById('mainBody_Password').value =
                    sha256(document.getElementById('mainBody_Password').value + salt);
            }
        }
    </script>
    <script type="text/javascript">
        function Baseurl() {
            var fullUrl = window.document.location.origin + '/';
          
            return fullUrl;

        }
        $("#btnRefreshCaptcha").click(function (e) {
            e.preventDefault();
            $.ajax({
                type: "POST",
                contentType: "application/json; charset=utf-8",
                url: "Login.aspx/GetCaptcha",
                data: "{}",
                dataType: "json",
                success: function (data) {
                    console.log(data.d);
                    RefreshCaptcha();
                },
                error: function (result) {

                    //alert("Server not responding pls try again.");
                }
            });
        });

        function RefreshCaptcha() {
           
            var img = document.getElementById("imgCaptcha");
            img.src = Baseurl() + "../capta.ashx?query=" + Math.random();
        }
        function HashPwdwithSalt() {
            var salt;
            $.ajax({
                type: "POST",
                contentType: "application/json; charset=utf-8",
                url: "Login.aspx/GetSalt",
                data: "{'strsize':'5'}",
                dataType: "json",
                success: function (data) {
                    salt = data.d;
                    //alert(data.d);
                    if (document.getElementById("mainBody_Password").value != "") {
                        document.getElementById("mainBody_Password").value =
                            sha256(document.getElementById("mainBody_Password").value);
                        document.getElementById("mainBody_Password").value = sha256(document.getElementById("mainBody_Password").value + salt);
                    }
                },
                error: function (result) {

                    //alert("Server not responding pls try again.");
                }
            });
        }

    </script>

  

<script>
    
    let countdown = null;
    let timeLeft = 0;

    
    // Update timer text immediately
    function updateTimerText(prefix) {
        let minutes = Math.floor(timeLeft / 60);
        let seconds = timeLeft % 60;

        document.getElementById("timerText").innerHTML =
            prefix + " " + minutes + ":" + (seconds < 10 ? "0" + seconds : seconds);
    }


    // NORMAL OTP TIMER (Verify ENABLED, Resend DISABLED)
    function startOTPTimerNormal(durationInSeconds) {

        if (countdown !== null) {
            clearInterval(countdown);
        }

        timeLeft = durationInSeconds;

        const resendBtn = document.getElementById("mainBody_btnResendOTP");
        const verifyBtn = document.getElementById("mainBody_btnVerifyOTP");

        // Verify enabled
        verifyBtn.disabled = false;
        verifyBtn.style.opacity = "1";
        verifyBtn.style.cursor = "pointer";

        // Resend disabled
        resendBtn.disabled = true;
        resendBtn.style.opacity = "0.5";
        resendBtn.style.cursor = "not-allowed";

        timeLeft = durationInSeconds - 1; //reduce 1 sec here
        // Show timer immediately
        updateTimerText("Resend OTP available in");

        countdown = setInterval(() => {
            timeLeft--;

            if (timeLeft < 0) {
                clearInterval(countdown);
                countdown = null;

                document.getElementById("timerText").innerHTML = "";

                resendBtn.disabled = false;
                resendBtn.style.opacity = "1";
                resendBtn.style.cursor = "pointer";
                return;
            }

            updateTimerText("Resend OTP available in");
        }, 1000);
       
    }

    // LOCK TIMER (Verify + Resend DISABLED)
    function startOTPLockTimer(seconds) {
        const verifyBtn = document.getElementById('mainBody_btnVerifyOTP');
      const resendBtn = document.getElementById('mainBody_btnResendOTP');

      verifyBtn.disabled = true;
      resendBtn.disabled = true;

      let timer = seconds;

      const interval = setInterval(function () {
          if (timer <= 0) {
              clearInterval(interval);
              verifyBtn.disabled = false;
              resendBtn.disabled = false;
              document.getElementById("timerText").innerText = "";
              return;
          }

          let min = Math.floor(timer / 60);
          let sec = timer % 60;

          document.getElementById("timerText").innerText =
              "OTP locked for " + min + ":" + (sec < 10 ? "0" + sec : sec);

          timer--;
      }, 1000);
  }

    //  Called when OTP is sent
    function openOTPModal() {
        document.getElementById("otpModal").style.display = "block";
        startOTPTimerNormal(180); //3 minutes
    }

    //  Called after 3 invalid OTP attempts
    function restartOTPTimer() {
        document.getElementById("otpModal").style.display = "block";
        startOTPTimerLock(180); 
    }

    function closeOTPModal() {
        $('#mainBody_txtOTP').val('');
        $('#mainBody_lblOTPMsg').val('');
       
        document.getElementById("otpModal").style.display = "none";
    }


</script>



    <script type="text/javascript">
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({ pageLanguage: 'en', layout: google.translate.TranslateElement.FloatPosition.TOP_LEFT }, 'google_translate_element');
        }
        function triggerHtmlEvent(element, eventName) {
            var event;
            if (document.createEvent) {
                event = document.createEvent('HTMLEvents');
                event.initEvent(eventName, true, true);
                element.dispatchEvent(event);
            } else {
                event = document.createEventObject();
                event.eventType = eventName;
                element.fireEvent('on' + event.eventType, event);
            }
        }
