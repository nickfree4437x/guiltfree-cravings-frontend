<style>
    /* Close (X) Button */


.close-icon {
    position: absolute;
    top: 10px;
    right: 15px;
    font-size: 28px;
    font-weight: bold;
    color: #333;
    cursor: pointer;
    z-index: 9999;
}
.close-icon:hover {
    color: red;
}

    /* Modal Background */
.modal {
    display: none;   /* default hidden */
    position: fixed;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.6);
    top: 0;
    left: 0;
}

.modal-content {
     position: relative;
    background: white;
    padding: 20px;
    margin: 17% auto;
    width: 500px;
    border-radius: 10px;
}
    /* Animation */
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-30px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* Title */
    .modal-title {
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 15px;
        color: #333;
    }

    /* Mobile Label */
    .mobile-label {
        font-weight: bold;
        color: #007bff;
    }

    /* OTP Input Box */
    .otp-input {
        width: 100%;
        padding: 8px;
        font-size: 18px;
        text-align: center;
        border: 2px solid #ddd;
        border-radius: 8px;
        margin: 5px 0;
        transition: 0.3s;
    }

    .otp-input:focus {
        border-color: #007bff;
        outline: none;
    }

    /* Buttons */
    .btn-primary {
        background: #007bff;
        color: #fff;
        border: none;
        padding: 12px 15px;
        width: 100%;
        font-size: 16px;
        border-radius: 8px;
        cursor: pointer;
        margin-top: 5px;
        transition: 0.3s;
    }
    .btn-primary:hover {
        background: #0056b3;
    }

    .btn-secondary {
        background: #6c757d;
        color: #fff;
        border: none;
        padding: 10px 15px;
        width: 100%;
        font-size: 15px;
        border-radius: 8px;
        cursor: pointer;
        margin-top: 10px;
        transition: 0.3s;
    }
    .btn-secondary:hover {
        background: #5a6268;
    }

    /* Error Message */
    .error-label {
        color: red;
        font-size: 14px;
        display: block;
        margin-top: 10px;
    }
</style>





