        //AboutUs.aspx
        $("#SpanAboutUsUsUs").text("हमारे बारे में");
        $("#SpanHistoryAboutUs").text("संक्षिप्त इतिहास");
        $("#SpanSecondWorldWarAboutUs").text("दूसरे विश्व युद्ध  की समाप्ति पर विमुक्त सैनिकों को सेवायोजित कराने के उद्देश्य से सन 1945 में केन्द्रीय स्तर पर पुनर्वास एवं रोजगार महानिदेशालय की स्थापना की गयी,जिसके नियंत्रण में देश के विभिन्न भागों में सेवायोजन कार्यालयों की स्थापना हुई। संसद सदस्य श्री शिवाराव की अध्यक्षता में 1952 में गठित प्रशिक्षण एवं सेवायोजन सेवा संगठन समिति की संस्तुतियों के कार्यान्वयन के फलस्वरूप 1956 से सेवायोजन कार्यालयों का दैनिक प्रशासन केन्द्रीय सरकार द्वारा प्रदेश शासन को हस्तान्तरित कर दिया गया तथा सेवायोजन कार्यालयों द्वारा अनुपालन की जाने वाली नीति एवं प्रक्रिया के निर्धारण का कार्य भारत सरकार को आंवटित किया गया। सेवायोजन कार्यालयों को अधिक प्रभावी बनाने के उद्देश्य से 1959 में भारतीय संसद द्वारा सेवायोजन कार्यालय (रिक्तियों का अनिवार्य अधिसूचन) अधिनियम, 1959 पारित किया गया, जिसे मई 1960 से पूरे देश में (जम्मू कश्मीर के अतिरिक्त) प्रभावी किया गया। वर्तमान में उत्तर प्रदेश में सेवायोजन सेवा के अन्तर्गत 90 सेवायोजन कार्यालय कार्यरत हैं। जिनमें 18 क्षेत्रीय सेवायोजन कार्यालय, 01 व्यावसायिक एवं प्रबन्धकीय सेवायोजन कार्यालय, 57 जिला सेवायोजन कार्यालय,13 विश्वविद्यालय सेवायोजन सूचना एवं मंत्रणा केन्द्र तथा 01 नगर सेवायोजन कार्यालय सम्मिलित हैं। इसके साथ ही अनुसूचित जाति, अनुसूचित जनजाति, अन्य पिछडे वर्ग तथा विकलांग वर्ग के अभ्यार्थियों की सेवायोजकता में वृद्धि करने के उद्देश्य से 52 शिक्षण एवं मार्ग दर्शन केन्द्र विभिन्न जनपदों में संचालित हैं।");
        $("#SpanScreenReaderAccess").text("वेबसाइट वर्ल्ड वाइड वेब कंसोर्टियम (W3C) वेब कंटेंट एक्सेसिबिलिटी गाइडलाइंस (WCAG) 2.0 लेवल AA का अनुपालन करती है। यह दृष्टिबाधित लोगों को स्क्रीन रीडर्स जैसी सहायक तकनीकों का उपयोग करके वेबसाइट तक पहुँचने में सक्षम करेगा। वेबसाइट की जानकारी विभिन्न स्क्रीन रीडर्स जैसे JAWS, NVDA, SAFA, Supernova और Window-Eyes के साथ उपलब्ध है। निम्न तालिका विभिन्न स्क्रीन रीडर्स के बारे में जानकारी सूचीबद्ध करती है:");
        $("#SpanOrganizationalStructureAboutUs").text("संगठनात्मक संरचना");
        $("#SpanSewayojanKiryaKalapDepAboutUs").text("सेवायोजन विभाग के क्रिया-कलाप :-");
        $("#SpanSARLinksHeader").text("विभिन्न स्क्रीन रीडर्स के बारे में जानकारी:-");
        $("#SpanEmployementSewayojanDepAboutUs").text("प्रशिक्षण एवं सेवायोजन विभाग के अधीन संचालित सेवायोजन कार्यालयों द्वारा नियोजकों द्वारा अधिसूचित रिक्तियों के सापेक्ष कार्यालय में पंजीकृत बेरोजगार अभ्यर्थियों का सम्प्रेषण कर उनको रोजगार के अवसर उपलब्ध कराए जाते हैं. साथ ही साथ बेरोजगार अभ्यर्थियों को करियर काउंसलिंग के माध्यम से रोजगार के अवसरों की जानकारी दी जाती है.निजी क्षेत्र के नियोजकों को आमंत्रित कर रोजगार मेलों का आयोजन भी विभाग द्वारा किया जाता है ताकि अधिक से अधिक बेरोजगारों को रोजगार के अवसर उपलब्ध कराए जा सके.");
        $("#SpanSewayojanDepAboutUs").text("सेवायोजन विभाग द्वारा निम्नलिखित योजनायें संचालित हैं :-");
        $("#spanCarrierCounslingAboutUs").text("1.करियर काउंसलिंग :");
        $("#SpanPurposePlanMakeCareerCounselingAboutUS").text("इस योजना का उद्देश्य करियर काउंसलिंग शिविरों का आयोजन कर बेरोजगारों को शिक्षण,प्रशिक्षण एवं रोजगार के अवसरों के अनुरूप विषय चयन में सहायता करना तथा रोजगार बाजार में उपलब्ध अवसरों के जानकारी प्रदान करना है. सेवायोजन विभाग में व्यवसाय मार्गदर्शन कार्यक्रम के अन्तर्गत छात्रों एवं बेरोजगारों को उपयुक्त आजीविका के चयन हेतु मार्गदर्शन प्रदान किये जाने का कार्य भारत सरकार के राष्ट्रीय रोजगार सेवा मैनुवल में की गयी व्यवस्था के अनुसार किया जाता है. इस योजना के अन्तर्गत अभ्यर्थियों की शैक्षिक उपलब्धियों‚ रूचि–अभिरूचि‚ पारिवारिक और आर्थिक पृष्ठभूमि और व्यवसाय जगत की परिवर्तनशील गतिविधियों के आधार पर व्यवसायिक मार्गदर्शन और मंत्रणा प्रदान की जाती है। इस कार्यक्रम के सम्यक् संचालन हेतु सेवायोजन कार्यालयों को शैक्षिक संस्थानों से सघन सम्पर्क स्थापित करना होता है।");
        $("#SpanPurposeNidesaliyaCarierCounslingAboutUS").text("उक्त उद्देश्यों की पूर्ति हेतु वर्ष 2006–07 में निदेशालय स्तर पर कॅरियर काउन्सिलिंग सेल की स्थापना की गयी‚ जिसका मुख्य उद्देश्य करियर काउन्सिलिंग  हेतु क्षेत्र के कार्यालयों के लिए लक्ष्यों का निर्धारण और उन्हें समय–समय पर मार्गदर्शन देना है। वर्ष 2008 में व्यवसाय मार्गदर्शन कार्यक्रम को अधिक गतिशील बनाने की दिशा में 'अभिनव प्रयास एवं नूतन दिशायें' कार्यक्रम के अन्तर्गत विभिन्न प्रकार के सघन एवं समन्वित कार्यक्रमों को आयोजित किए जाने की व्यवस्था सुनिश्चित की गयी तथा इस कार्यक्रम का नाम “करियर काउन्सिलिंग” कर दिया गया। वर्ष 2008–09 में 'अवसर' नामोदिष्ट कार्यक्रम के अन्तर्गत विभिन्न क्षेत्रीय एवं जिला सेवायोजन कार्यालयों के अतिरिक्त विश्वविद्या्लय सेवायोजन सूचना एवं मंत्रणा केन्द्रों  द्वारा लक्ष्यानुरूप कार्यशालाएँ आयोजित की गयी। इस प्रकार प्रत्येक वर्ष करियर काउन्सिलिंग शिविरों का आयोजन किया जा रहा है.");

        $("#SpanCarrierCounsilgSiverAboutUs").text("इस प्रकार प्रत्येक वर्ष करियर काउन्सिलिंग शिविरों का आयोजन किया जा रहा है.");
        $("#SpanAvsarDivasAboutUS").text("•	अवसर दिवस – प्रत्येक वर्ष 06 जनवरी को.");
        $("#SpanSamadhanAvsarAboutUS").text("• समाधान अवसर – 15 अप्रैल से 31 जुलाई के मध्य");
        $("#SpanbusinessPakhvadaAboutUS").text("• अपना व्यवसाय चुनिए पखवाडा – 15 अगस्त से 31 अगस्त के मध्य");
        $("#SpanCarierCounslingAboutUS").text("• करियर काउन्सिलिंग (सेमीनार⁄ कार्यशाला) – सितम्बर से दिसम्बर तक");
        
        $("#SpanRojgarMelaAboutUS").text("2.रोजगार मेला :");
        $("#SpanStateSewayojanOfficeAboutUS").text("प्रदेश के सेवायोजन कार्यालयों द्वारा निजी क्षेत्र में भी बेरोजगार अभ्यर्थियों को रोजगार के अवसर उपलब्ध करने के प्रयास किये जा रहे हैं .सेवायोजन कार्यालयों द्वारा बेरोजगार अभ्यर्थियों एवं नियोजकों को एक ही स्थान पर आमंत्रित कर रोजगार मेलों का आयोजन किया जाता है, जिसमें नियोजक अपनी आवश्कतानुसार बेरोजगार अभ्यर्थियों का चयन करते हैं.तथा  बेरोजगार अभ्यर्थियों को भी अपनी इच्छानुसार संस्थान/कंपनी चयन करने की सुविधा उपलब्ध रहती है.");
        $("#SpanRojgarMelaParticipateAboutUs").text("रोजगार मेलें में प्रतिभाग करने हेतु सर्वप्रथम जॉब सीकर को सेवायोजन पोर्टल पर अपना पंजीकरण कराना आवश्यक है. बेरोजगार अभ्यर्थियों के समान ही नियोजकों के भी उक्त पोर्टल पर पंजीकरण की व्यवस्था की गयी है .पंजीकरण के उपरांत नियोजक अपने संस्थान की रिक्तियों को सेवायोजन पोर्टल पर अपलोड कर सकते है.  उक्त अधिसूचित रिक्तियों के सापेक्ष जिन बेरोजगार अभ्यर्थियों की प्रोफाइल मैच करती है उनको सिस्टम जनरेटेड मेल प्रेषित हो जाएगी कि आपकी शैक्षिक योग्यता ,कौशल एवं अनुभव के अनुरूप रिक्तियां पोर्टल पर अपलोड की गयी है. अत: आप “प्रथम आओ प्रथम पाओ” के आधार पर निर्धारित संख्या तक आवेदन कर सकते है.ऐसे आवेदित अभ्यर्थियों की सूची नियोजक एवं एडमिन पैनल पर प्रदर्शित करने की व्यवस्था भी पोर्टल पर की गयी है. नियोजक द्वारा उक्त सूची के आधार पर अपनी आवश्यकतानुसार अभ्यर्थियों को सॉर्ट लिस्ट किया जा सकेगा. ऐसे सॉर्ट लिस्टेड अभ्यर्थियों को सम्बंधित सेवायोजन अधिकारी द्वारा ई-मेल के माध्यम से रोजगार मेलों में प्रतिभाग करने हेतु आमंत्रित किये जाने की व्यवस्था की गयी है. रोजगार मेलों का आयोजन सम्बंधित जनपद स्तरीय समिति द्वारा सम्पादित किया जायेगा. चयन के उपरांत नियोजक चयनित अभ्यर्थियों की सूची सम्बंधित सेवायोजन अधिकारी को उपलब्ध करायेंगें जिसको उनके द्वारा उक्त पोर्टल पर अपलोड कर दिया जायेगा.");
        $("#SpanEducationCenterAboutUS").text("3.शिक्षण एवं मार्गदर्शन केंद्र  :");
        $("#SpanfiftyTwoDistrictAboutUS").text("प्रदेश के 52 जनपदों में स्थापित शिक्षण एवं मार्गदर्शन केन्द्रों का मुख्य उद्देश्य समाज के निर्बल वर्ग यथा अनुसूचित जाति/जनजाति एवं अन्य पिछड़ा वर्ग के अभ्यर्थियों भाषा,सचिवीय पद्यति, कंप्यूटर ,आशुलिपि एवं सामान्य ज्ञान में प्रशिक्षण प्रदान कर उनकी सेवायोजकता में वृद्धि करना है.");
        $("#SpanModelCarrierCenterAboutUs").text("4.माडल करियर सेन्टर :");
        $("#SpanMahanidesakRojgarEmployementAboutUS").text("महानिदेशक, रोजगार एवं प्रशिक्षण ,भारत सरकार, नई दिल्ली के निर्देशों के क्रम में निदेशालय में कार्यरत करियर काउंसलिंग सेल तथा जिला सेवायोजन कार्यालय ,गाजियाबाद को माडल करियर सेन्टर के रूप में विकसित किये जाने का प्रस्ताव भारत सरकार द्वारा स्वीकार किया जा चुका है.");
        $("#SpanModelCarrierCenterAboutUS").text("माडल करियर सेन्टर का कार्य पूरे प्रदेश के अध्ययनरत छात्र-छात्राओं तथा प्रशिक्षण संस्थानों में अध्ययन कर प्रशिक्षार्थियो से सम्बंधित है. इस सेन्टर द्वारा वर्तमान परिवेश में शिक्षण ,प्रशिक्षण एवं रोजगार के नए उभरते व्यवसायों की जानकारी प्रदान की जाती है.");
        $("#SpanRojgarInfoAboutUs").text("5.रोजगार बाजार सूचना :-");
        $("#SpanRojgarMelaRelationAboutUs").text("रोजगार ⁄ बेरोजगारी के विभिन्न आयामों के संबंध में सूचनाओं का एकत्रीकरण, संकलन, प्रचार एवं प्रसार। राज्य  रोजगार बाजार सूचना कार्यक्रम के अंतर्गत प्रदेश के संगठित क्षेत्र के नियोजको से त्रिमास के अन्त में उनके संस्थानों में कार्यरत  कर्मचारियों की संख्या त्रिमास में उत्पन्न रिक्तियों, सेवायोजको द्वारा रिक्तियों हेतु उपयुक्त अभ्यर्थियों की कमी की सूचना संबंधित क्षेत्र के क्षेत्रीय  / जिला/ नगर /सेवायोजन कार्यालय द्वारा त्रैमासिक आधार पर एकत्र की जाती हैं |वर्तमान समय में उक्त सूचनाएं  सार्वजनिक  क्षेत्र के समस्त अधिष्ठानों एवं निजी  क्षेत्र के अकृषि  अधिष्ठानों द्वारा जिनके यहाँ प्रायः 25 या उससे अधिक कर्मचारी कार्यरत हैं, सेवायोजन कार्यालय (रिक्तियो का  अनिवार्य अधिसूचन) अधिनियम 1959  के अंतर्गत  निर्धारित प्रपत्र ई०आर०-1 पर अधिनियम की धारा-5 तथा तत्सम्बन्धी नियमावली के अंतर्गत प्रेषित करना अनिवार्य हैं | एक  वर्ष सार्वजनिक तथा दूसरे वर्ष  निजी क्षेत्र के अधिष्ठानों में कार्यरत कर्मचारियों की व्यवसायानुसार एवं शैक्षिक /प्राविधिक योग्यतानुसार संख्या की सूचना एकत्रित की जाती हैं |");
        $("#SpanSewayojanOfficeVacancyAboutUs").text("6.सेवायोजन कार्यालय (रिक्तियों का अनिवार्य अधिसूचन )अधिनियम का प्रवर्तन  :- ");
        $("#SpanSewayojanOfficeVacEPAboutUs").text("1-	संसद द्वारा सेवायोजन कार्यालय (रिक्तियों का अनिवार्य अधिसूचन) अधिनियम 1959 पारित किया गया, जिसे भारत सरकार के श्रम मंत्रालय  की विज्ञप्ति सं. ई०पी०/11/(1)60, दिनांक 01-04-1960 द्वारा इसी तिथि से सम्पूर्ण देश में लागू कर दिया गया | इस अधिनियम की परिसीमा में सार्वजनिक क्षेत्र के  समस्त सेवायोजक तथा निजी क्षेत्र के (कृषि क्षेत्र के अतिरिक्त) वें सेवायोजक हैं, जिनके कार्यालय/संस्थानों/प्रतिष्ठानों में सामान्यतया 25 या इससे अधिक कर्मचारी सेवारत हैं |");
        $("#SpanAdhineumDharaFourAboutUs").text("2-उपर्युक्त अधिनियम की धारा -4 में दी गयी व्यवस्थाओं के अनुसार अधिनियम के अंतर्गत आने वाले सेवायोजकों का यह वैधानिक दायित्व  है कि वे धारा -3 द्वारा  अवमुक्त रिक्तियों  के अतिरिक्त अपने  कार्यालय/ संस्थानों/ प्रतिष्ठानों में होने वाली समस्त रिक्तियां  अधिनियमान्तर्गत निर्मित नियमावली 1960 की नियम -4 द्वारा निर्धारित प्रारूप पर कम से कम 15 दिनों का समय देते  हुए  सम्बंधित सेवायोजन कार्यालय को अधिसूचित करें |");
        $("#SpanAdhineumDharaFiveAboutUs").text("3-	अधिनियम की धारा -5 में यह व्यवस्था हैं कि सेवायोजक नियमावली 1960 के नियम – 6 में विनिर्दिष्ट  परिलेख ई०आर०-1, ई०आर०-2 में   सूचनायें  त्रिमासिक / द्विवार्षिक आधार पर अपने क्षेत्र के  सेवायोजन कार्यालयों को उपलब्ध करायेगे |");
        $("#SpanAdhineumDharaSixAboutUs").text("4-	 अधिनियम की धारा- 6 में निहित व्यवस्था के आधार पर विभाग के अधिकारियों द्वारा नियोजकों के नियुक्ति सम्बन्धी  अभिलेखों का  निरीक्षण कर यह सुनिश्चित किया जाता हैं कि अधिनियम कि विभिन्न धाराओं का विधिवत पालन किया जा रहा है |");
        $("#SpanAdhineumDharaSevenAboutUs").text("5-अधिनियम कि धारा -7 के अंतर्गत दोषी पाये गये नियोजकों के विरुद्ध दण्डात्मक कार्यवाही की व्यवस्था है |");
        $("#SpanAdhineumDharaImprtantAdhineumAboutUs").text("महत्वपूर्ण अधिनियम एवं विनियमन");
        $("#SpanSerialNoAboutUS").text("क्र० सं०");
        $("#SpanTitleAboutUS").text("शीर्षक");
        $("#SpanTypeodFileAboutUS").text("फ़ाइल का प्रकार");
        $("#SpanSizeofFileAboutUs").text("फ़ाइल का साइज़");
        $("#SpanAdhisuchanAdhineumVacAboutUs").text("रिक्तियों का अनिवार्य अधिसूचन , अधिनियम 1959");
        $("#SpanRuleVacAboutUs").text("रिक्तियों का अनिवार्य अधिसूचन , नियमावली");
        $("#SpanSewayojanOfficeMenualPartOneAboutUs").text("सेवायोजन कार्यालयों का संचालन मैनुअल भाग I");
        $("#SpanSewayojanOfficeMenualPartTwoAboutUs").text("सेवायोजन कार्यालयों का संचालन मैनुअल भाग II");
        $("#SpanSewayojanOfficeMenualPartThreeAboutUs").text("सेवायोजन कार्यालयों का संचालन मैनुअल भाग III");
