        $("#SpanAbout").text("हमारे बारे में");
        $("#SpanLogin").text("लॉग इन करें");
        $("#SpanNewAccount").text("नया अकाउंट बनाए");
        $("#SpanLoginnPage").text("लॉग इन");
        $("#SpanSignUp").text("साइन अप");
        $("#SpanFrequntlyAskQ").text("अक्सर पूछें जाने वाले प्रश्न");
        $("#SpanContactUs").text("संपर्क करें");
        $("#SpanAboutUs").text("हमारें बारें में");
        $("#SpanScreenReader").text("स्क्रीन रीडर एक्सेस");
        
        //$("#myModalLabel").text("लॉग इन");
        $("#SpanAdmin").text("प्रशासनिक :");
        $("#SpanForEmployer").text("नियोजक हेतु:");
        $("#SpanOneLackEmployer").text("लाखों अभ्यार्थी एक क्लिक पर उपलब्ध ।");
        $("#SpanGovJobUpload").text("24*7 नौकरियां अपलोड करने की सुविधा ।");
        $("#SpanAllDistrict").text("समस्त जनपद में रोजगार मेलों के आयोजन की सुविधा ।");
        $("#SpanOnlineRegistration").text("ऑनलाइन पंजीकरण कहीं भी कभी भी ।");
        $("#SpanOnlineReturn").text("ऑनलाइन रिटर्न्स फाइल करने की सुविधा ।");
        $("#SpanUserManual").text("यूजर  मैनुअल ( नियोजक )");
        $("#SpanJobSeeker").text("जॉब सीकर हेतु:");
        $("#SpanOnlineRegistrationn").text("ऑनलाइन पंजीयन कहीं भी कभी भी ।");
        $("#SpanAllGovJobs").text("समस्त सरकारी नौकरियां एक पोर्टल पर उपलब्ध ।");
